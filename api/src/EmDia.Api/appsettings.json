{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "emdia-api",
    "Audience": "emdia-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Security": {
    "MaxFalhasLogin": 5,
    "BloqueioMinutos": 15,
    "LoginTentativasPorMinuto": 5,
    "RequisicoesPorMinuto": 300
  },
  "Cors": {
    "Origens": [ "https://emdia.app" ]
  },
  "Email": {
    "Remetente": "noreply@emdia.app",
    "Smtp": {
      "Host": "",
      "Porta": 587
    }
  }
}
